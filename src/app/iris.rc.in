#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @IRIS_VERSION_MAJOR@,@IRIS_VERSION_MINOR@,@IRIS_VERSION_PATCH@,0
PRODUCTVERSION @IRIS_VERSION_MAJOR@,@IRIS_VERSION_MINOR@,@IRIS_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Project Iris"
            VALUE "FileDescription", "Iris Emulator"
            VALUE "FileVersion", "@IRIS_VERSION_STRING@"
            VALUE "InternalName", "iris"
            VALUE "LegalCopyright", "See LICENSE and THIRD_PARTY_NOTICES.md"
            VALUE "OriginalFilename", "iris.exe"
            VALUE "ProductName", "Iris Emulator"
            VALUE "ProductVersion", "@IRIS_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
